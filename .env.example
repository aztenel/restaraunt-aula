# Переменные docker compose (подставляются в docker-compose*.yml). Скопируйте в .env рядом с compose-файлом.
# Переменные самих приложений — в apps/api/.env.example, apps/web/.env.example, apps/admin/.env.example.
# Реальные значения секретов в репозиторий не коммитятся (.env в .gitignore).

# =============================================================================
# Локальная разработка: docker-compose.yml
# =============================================================================
# Порты на хосте (меняйте, если заняты)
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Учётная запись MinIO (она же S3_ACCESS_KEY / S3_SECRET_KEY в apps/api/.env), бакет
MINIO_ROOT_USER=aula-minio
MINIO_ROOT_PASSWORD=aula-minio-secret
S3_BUCKET=aula

# Образы MinIO (официальные больше не публикуются на Docker Hub — используется сборка сообщества)
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

# =============================================================================
# Сервер staging / production: docker-compose.prod.yml (файл /opt/aula/.env)
# =============================================================================
# Окружение: staging | production. Определяет тег образов web/admin (<версия>-<окружение>)
# и SENTRY_ENVIRONMENT.
DEPLOY_ENV=production

# Реестр образов (GitHub Container Registry организации клиента, в нижнем регистре).
REGISTRY=ghcr.io/aula-kz

# Тег версии НЕ задаётся здесь: его передают ops/deploy/deploy.sh / rollback.sh,
# а ops/deploy/compose.sh берёт текущий из .deploy/current_tag.
# TAG=v1.0.0

# Домены (DNS A/AAAA → IP сервера). Сертификаты TLS Caddy выпускает автоматически.
WEB_DOMAIN=aula.kz
ADMIN_DOMAIN=admin.aula.kz
API_DOMAIN=api.aula.kz
# Почта для уведомлений Let's Encrypt (ящик клиента, не разработчика).
ACME_EMAIL=it@aula.kz
# staging: noindex,nofollow — тестовый стенд не индексируется поисковиками
WEB_ROBOTS_TAG=all

# PostgreSQL в контейнере: COMPOSE_PROFILES=db. С управляемым PostgreSQL — оставить пустым.
COMPOSE_PROFILES=db
POSTGRES_DB=aula
POSTGRES_USER=aula
# Сгенерировать: openssl rand -base64 32 | tr -d '/+=' ; то же значение — в DATABASE_URL (env/api.env)
POSTGRES_PASSWORD=change-me
# Память PostgreSQL: ~25% RAM сервера / ~75% RAM сервера
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB

# Параллельность обработки задач одним воркером
WORKER_CONCURRENCY=5
