  "info": {
    "title": "AULA API",
    "description": "Единый REST API AULA: витрина, заказ, бронь, банкеты, сертификаты, админка. Деньги — целые числа в тиынах с валютой. Время — ISO 8601 в UTC, отображение в Asia/Almaty.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "public",
      "description": "Публичная витрина (гость)"
    },
    {
      "name": "admin",
      "description": "Админ-панель (сотрудники)"
    },
    {
      "name": "webhooks",
      "description": "Входящие вебхуки провайдеров"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "staff": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@aula.kz"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Время жизни access-токена, секунд"
          },
          "mustChangePassword": {
            "type": "boolean"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "mustChangePassword"
        ]
      },
      "RoleAssignmentDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "branch_operator",
              "banquet_manager",
              "branch_manager",
              "content_manager",
              "finance",
              "owner",
              "sysadmin"
            ]
          },
          "branchId": {
            "type": "object",
            "nullable": true,
            "description": "Филиал для филиальных ролей; null для глобальных"
          }
        },
        "required": [
          "role"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "mustChangePassword": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleAssignmentDto"
            }
          },
          "globalPermissions": {
            "description": "Права во всех филиалах",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "branchPermissions": {
            "type": "object",
