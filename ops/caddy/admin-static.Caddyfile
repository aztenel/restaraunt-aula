# Раздача статики админ-панели внутри контейнера aula-admin (порт 8080, HTTP).
# TLS, HSTS и заголовки безопасности добавляет внешний reverse proxy (ops/caddy/Caddyfile).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Хэшированные ассеты Vite: имя меняется при каждом изменении содержимого — кэшируем на год.
	# Без SPA-fallback: отсутствующий ассет должен дать 404, а не index.html с долгим кэшем.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Всё остальное — SPA: существующий файл или index.html (клиентский роутинг).
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
