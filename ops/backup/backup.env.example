# Окружение контейнера backup. На сервере: /opt/aula/env/backup.env (chmod 600).
# Значения со спецсимволами ($, пробелы, #) заключайте в одинарные кавычки.

# База для pg_dump. С профилем db — контейнер postgres; с управляемым PostgreSQL — его адрес
# (пользователь с правом чтения всех схем; для verify-restore на staging — ещё и CREATEDB).
BACKUP_DATABASE_URL=postgres://aula:change-me@postgres:5432/aula

# rclone-пути (имена remote — из env/rclone.conf, см. ops/backup/rclone.conf.example)
# Источник файлов: бакет приложения (S3_BUCKET из env/api.env). none — без файлов (только STORAGE_DRIVER=local).
BACKUP_FILES_SOURCE=app-s3:aula-production
# Основное хранилище бэкапов и внешняя копия у другого провайдера (оба — в РК, зашифрованы crypt).
BACKUP_PRIMARY_REMOTE=backup-primary:production
BACKUP_OFFSITE_REMOTE=backup-offsite:production

# Хранение (ТЗ: 30 дней). Последние BACKUP_MIN_KEEP дампов не удаляются никогда.
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_KEEP=7

# Расписание (cron, 5 полей, часовой пояс TZ). По умолчанию 30 3 * * * — ежедневно в 03:30.
BACKUP_CRON=30 3 * * *
TZ=Asia/Almaty

# Внешний «пульс» (dead man's switch): URL, который бэкап вызывает при успехе, — push-монитор
# Uptime Kuma или healthchecks.io. Нет вызова дольше 26 ч — оповещение. Пусто — не используется.
BACKUP_HEARTBEAT_URL=

# --- Только STAGING: квартальная проверка восстановления (ops/backup/verify-restore.sh) ---
# Откуда брать бэкапы PRODUCTION (remote только на чтение, см. rclone.conf.example).
# Пусто — проверяются бэкапы этого же окружения (BACKUP_PRIMARY_REMOTE / BACKUP_OFFSITE_REMOTE).
VERIFY_SOURCE_PRIMARY=
VERIFY_SOURCE_OFFSITE=
# Сервер PostgreSQL staging для временной базы (пользователь с CREATEDB). Пусто — BACKUP_DATABASE_URL.
VERIFY_ADMIN_DATABASE_URL=
# Ключевые таблицы для smoke-проверки (через пробел). Пусто — список по умолчанию из verify-restore.sh.
VERIFY_KEY_TABLES=
