      "description": "1 — /api/v1/health/ready отвечает 200 (БД и Redis доступны).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(probe_success{job=\"blackbox-internal\",service=\"api\"})",
          "instant": true,
          "legendFormat": ""
