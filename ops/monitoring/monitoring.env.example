# Окружение стека мониторинга. На сервере: /opt/aula/env/monitoring.env (chmod 600).
# Учётные записи (бот Telegram, Grafana) оформляются на клиента, не на разработчика.

# Telegram: бот от @BotFather, бот добавлен в чат дежурных. chat_id группы — отрицательное число
# (узнать: написать в чат и открыть https://api.telegram.org/bot<токен>/getUpdates).
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_CHAT_ID=-1001234567890

# Grafana: администратор (сменить пароль при первом входе).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
