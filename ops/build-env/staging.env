# Публичные параметры сборки фронтендов для STAGING (build-args образов aula-web и aula-admin).
# NEXT_PUBLIC_*, VITE_* и хосты картинок встраиваются в JavaScript/конфигурацию при сборке и видны
# в браузере — секретов здесь быть не может. Файл версионируется вместе с кодом: тег релиза фиксирует
# и параметры сборки. Формат: KEY=value на строку, без кавычек и пробелов вокруг '='.
# Используется .github/workflows/deploy.yml (оба образа получают весь файл, каждый берёт свои ARG).

# --- Витрина (apps/web) ---
# Пусто — тот же origin: Caddy проксирует /api/v1/* на домене витрины в API (без CORS-preflight).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://staging.aula.kz
# На staging аналитика не подключается, чтобы не искажать цели production.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_2GIS_API_KEY=
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Хосты картинок next/image: CDN бакета (S3_PUBLIC_URL в env/api.env) и origin сайта.
S3_PUBLIC_URL=https://cdn.staging.aula.kz
IMAGE_HOSTS=https://staging.aula.kz
SENTRY_ORG=
SENTRY_PROJECT=aula-web

# --- Админка (apps/admin) ---
# Пусто — тот же origin: Caddy проксирует /api/v1/* на домене админки в API
# (refresh-cookie SameSite=Strict, path=/api/v1/admin/auth работает без CORS).
VITE_API_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
