{
  "name": "@aula/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Типизированный клиент AULA API, генерируется из docs/openapi.json (openapi-typescript + openapi-fetch)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
