# Окружение AULA API / worker / migrate / seed.
# Полный список и проверка значений — apps/api/src/shared/infrastructure/config/config.ts
# (приложение не стартует с некорректной конфигурацией).
#
# Локально: значения по умолчанию в config.ts уже совпадают с docker-compose.yml, поэтому для старта
# этот файл не обязателен. На сервере файл лежит в /opt/aula/env/api.env (см. docs/operations.md).
# Секреты интеграций (Kaspi, WhatsApp, SMS, POS...) задаются в админке и хранятся зашифрованными в БД.

# -----------------------------------------------------------------------------
# Приложение
# -----------------------------------------------------------------------------
# development | test | staging | production. В production обязательны свои JWT_SECRET и APP_ENCRYPTION_KEY.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent. В dev — человекочитаемый вывод, иначе JSON (pino).
LOG_LEVEL=info
# За reverse proxy (Caddy) — true: IP клиента берётся из X-Forwarded-For (лимиты частоты, журнал действий).
TRUST_PROXY=true
# Источники браузерных запросов через CORS (через запятую). В production при same-origin-схеме
# (/api/v1 на доменах витрины и админки) CORS не используется, но домены стоит перечислить.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Публичные адреса: ссылки в письмах, PDF, WhatsApp, redirect после оплаты, подписанные ссылки на файлы.
PUBLIC_WEB_URL=http://localhost:3001
ADMIN_URL=http://localhost:5173
# Origin API без /api/v1 (пути OpenAPI уже содержат /api/v1). Production: https://api.aula.kz
API_PUBLIC_URL=http://localhost:3000

# Swagger UI: /api/v1/docs, JSON: /api/v1/docs/openapi.json. В production можно выключить.
SWAGGER_ENABLED=true
# Версия релиза (тег git); на сервере подставляется docker-compose.prod.yml из TAG.
RELEASE=dev

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://aula:aula@localhost:5432/aula
# Пул на процесс. Сумма по процессам (api × реплики + worker + migrate) < max_connections.
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Redis + очереди (BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# bullmq — задачи выполняет отдельный процесс worker (pnpm dev:worker);
# inline — задачи выполняются в процессе API сразу после коммита (удобно для отладки без воркера).
QUEUE_DRIVER=bullmq
QUEUE_PREFIX=aula
# Только для QUEUE_DRIVER=inline: выполнять задачи сразу после коммита (dev). В тестах — false.
QUEUE_INLINE_AUTODRAIN=true
# Параллельность обработчиков в одном процессе worker.
WORKER_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Безопасность
# -----------------------------------------------------------------------------
# Секрет подписи JWT, не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Ключ шифрования секретов интеграций и подписей (ровно 32 байта в base64). Сгенерировать: openssl rand -base64 32
# ВНИМАНИЕ: при потере ключа сохранённые в БД секреты интеграций не расшифровать — храните в менеджере паролей клиента.
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# -----------------------------------------------------------------------------
# Файлы (фото блюд — public/, PDF смет/счетов/сертификатов — private/)
# -----------------------------------------------------------------------------
# local — диск (LOCAL_STORAGE_DIR, раздаёт сам API), s3 — S3-совместимое хранилище (production, MinIO локально).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# --- S3 / MinIO (для STORAGE_DRIVER=s3). Локальный MinIO из docker-compose.yml: ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=aula
# S3_ACCESS_KEY=aula-minio
# S3_SECRET_KEY=aula-minio-secret
# Публичный базовый URL файлов (CDN или бакет); ссылка на файл: <S3_PUBLIC_URL>/public/<ключ>.
# S3_PUBLIC_URL=http://localhost:9000/aula
# S3_FORCE_PATH_STYLE=true
# --- Production (пример): хранилище провайдера в РК + CDN ---
# S3_ENDPOINT=https://s3.example-provider.kz
# S3_REGION=kz-1
# S3_BUCKET=aula-production
# S3_PUBLIC_URL=https://cdn.aula.kz
S3_REGION=us-east-1
S3_BUCKET=aula
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Наблюдаемость
# -----------------------------------------------------------------------------
# Sentry: без DSN сбор ошибок выключен. SENTRY_ENVIRONMENT по умолчанию = NODE_ENV (на сервере = DEPLOY_ENV).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# Токен для /api/v1/metrics (Prometheus, заголовок Authorization: Bearer <токен>). Пусто — без защиты (только dev!).
# На сервере то же значение — в env/metrics_token (читает Prometheus). Сгенерировать: openssl rand -hex 32
METRICS_TOKEN=

# Дополнительные корневые сертификаты для исходящих TLS-подключений (например, НУЦ РК для ИС ЭСФ / NCANode).
# NODE_EXTRA_CA_CERTS=/app/certs/nca-rk.pem

# -----------------------------------------------------------------------------
# Стартовые данные: pnpm --filter @aula/api seed (на сервере: node dist/cli/seed.js)
# -----------------------------------------------------------------------------
# true — демо-сотрудники, меню, залы (dev/staging). В production не включать.
SEED_DEMO=false
SEED_OWNER_EMAIL=owner@aula.kz
# Пусто — временный пароль генерируется, выводится в лог и требует смены при первом входе.
SEED_OWNER_PASSWORD=
SEED_ADMIN_EMAIL=admin@aula.kz
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Интеграции: начальные значения (необязательно)
# -----------------------------------------------------------------------------
# Основной способ — админка → Интеграции (секреты шифруются APP_ENCRYPTION_KEY и хранятся в БД).
# Переменная INTEGRATION__<МОДУЛЬ>__<ПРОВАЙДЕР> (JSON) используется, только пока в БД нет записи
# с этим ключом ('<модуль>.<провайдер>', точки → '__', верхний регистр). Удобно для staging/CI.
# Поля config/secrets у каждого адаптера свои — см. каталог в админке (Интеграции). Примеры:
#
# INTEGRATION__PAYMENTS__SANDBOX={"enabled":true,"config":{}}
# INTEGRATION__PAYMENTS__KASPI={"enabled":true,"config":{"merchantId":"..."},"secrets":{"apiKey":"..."}}
# INTEGRATION__PAYMENTS__HALYK={"enabled":false,"config":{"terminalId":"..."},"secrets":{"clientId":"...","clientSecret":"..."}}
# INTEGRATION__NOTIFICATIONS__WHATSAPP={"enabled":true,"config":{"phoneNumberId":"..."},"secrets":{"accessToken":"..."}}
# INTEGRATION__NOTIFICATIONS__SMS={"enabled":true,"config":{"sender":"AULA"},"secrets":{"apiKey":"..."}}
# INTEGRATION__NOTIFICATIONS__TELEGRAM={"enabled":false,"secrets":{"botToken":"..."}}
# Почта через Mailpit (docker-compose.yml): письма видны на http://localhost:8025
# INTEGRATION__NOTIFICATIONS__EMAIL={"enabled":true,"config":{"host":"localhost","port":1025,"secure":false,"from":"AULA <no-reply@aula.kz>"}}
# INTEGRATION__POS__IIKO={"enabled":false,"config":{"organizationId":"..."},"secrets":{"apiLogin":"..."}}

# -----------------------------------------------------------------------------
# Тесты (pnpm --filter @aula/api test:integration)
# -----------------------------------------------------------------------------
# База для интеграционных тестов (создаётся автоматически). Параллельные разработчики — разные имена.
# TEST_DATABASE_URL=postgres://aula:aula@localhost:5432/aula_test
# TEST_DATABASE_NAME=aula_test
