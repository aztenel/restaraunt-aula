{
  "name": "@aula/api",
  "version": "0.1.0",
  "private": true,
  "description": "AULA backend: модульный монолит (NestJS + PostgreSQL + Redis/BullMQ)",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "nest start --watch --builder swc --entryFile main",
    "dev:worker": "nest start --watch --builder swc --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node -r @swc-node/register src/cli/migrate.ts",
    "migrate:prod": "node dist/cli/migrate.js",
    "seed": "node -r @swc-node/register src/cli/seed.ts",
    "seed:prod": "node dist/cli/seed.js",
    "openapi": "node -r @swc-node/register src/cli/openapi.ts",
    "db:schema-doc": "node -r @swc-node/register src/cli/schema-doc.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:boundaries": "eslint --rule '{}' \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@sentry/node": "9.47.1",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "fast-xml-parser": "4.5.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "kysely": "0.28.17",
    "nestjs-pino": "4.6.1",
    "nodemailer": "6.10.1",
    "pdfmake": "0.2.23",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "sharp": "0.34.5",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/nodemailer": "6.4.24",
    "@types/pdfmake": "0.2.13",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "5.4.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
