# Окружение витрины AULA (Next.js). Локально: скопируйте в apps/web/.env.local.
#
# ВАЖНО: переменные NEXT_PUBLIC_* (и всё, что читает next.config.ts) встраиваются ПРИ СБОРКЕ (next build).
# Для staging/production их значения задаются в ops/build-env/<окружение>.env (публичные данные,
# секретов там быть не может) и передаются в образ как build-args.
# Серверные переменные читаются при запуске контейнера из /opt/aula/env/web.env.

# =============================================================================
# Сборка (публичные, попадают в браузер / в next.config)
# =============================================================================
# Origin API для браузера, без /api/v1 (пути клиента @aula/api-client уже содержат /api/v1).
# Пустая строка — тот же origin: в staging/production Caddy проксирует /api/v1/* на домене витрины в API
# (нет CORS-preflight — минус запрос на 4G). Локально — API напрямую.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Канонический адрес сайта: canonical, hreflang, sitemap.xml, Open Graph, микроразметка Restaurant/Menu.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Аналитика (ТЗ: Google Analytics, Яндекс.Метрика, цели). Пусто — счётчик не подключается.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# Sentry в браузере. Пусто — SDK не загружается.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Карта (страницы филиалов, выбор адреса доставки): osm | yandex | 2gis
NEXT_PUBLIC_MAP_PROVIDER=osm
# Ключ JavaScript API Яндекс.Карт (ограничьте по HTTP Referer в кабинете разработчика).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Ключ 2ГИС MapGL (ограничьте по домену).
NEXT_PUBLIC_2GIS_API_KEY=
# Тайлы Leaflet при NEXT_PUBLIC_MAP_PROVIDER=osm (для production — свой или коммерческий тайл-сервер).
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Хосты картинок для next/image (images.remotePatterns в next.config.ts): публичные файлы API и S3/CDN.
# API_PUBLIC_URL — origin API (STORAGE_DRIVER=local), S3_PUBLIC_URL — CDN/бакет, IMAGE_HOSTS — доп. хосты через запятую.
API_PUBLIC_URL=http://localhost:3000
# S3_PUBLIC_URL=http://localhost:9000/aula
# IMAGE_HOSTS=https://cdn.aula.kz

# Загрузка source maps в Sentry при сборке. SENTRY_AUTH_TOKEN — секрет CI (BuildKit-секрет, не build-arg).
# SENTRY_ORG=
# SENTRY_PROJECT=aula-web
# SENTRY_AUTH_TOKEN=

# =============================================================================
# Сервер (читаются при запуске, в браузер не попадают)
# =============================================================================
# Адрес API для серверного рендеринга (SSR, sitemap). В Docker — внутренняя сеть: http://api:3000
API_INTERNAL_URL=http://localhost:3000
# Публичный адрес сайта в рантайме (перекрывает NEXT_PUBLIC_SITE_URL для canonical/sitemap на сервере).
SITE_URL=http://localhost:3001
# Sentry для серверной части Next.js (по умолчанию берётся NEXT_PUBLIC_SENTRY_DSN).
# На сервере SENTRY_ENVIRONMENT и SENTRY_RELEASE подставляет docker-compose.prod.yml (DEPLOY_ENV, TAG).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE=v1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
# Порт сервера Next.js (в образе — 3001).
PORT=3001
