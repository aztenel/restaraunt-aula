# Окружение витрины AULA (Next.js). Локально: скопируйте в apps/web/.env.local.
#
# ВАЖНО: переменные NEXT_PUBLIC_* встраиваются в JS-бандл ПРИ СБОРКЕ (next build), а не читаются при запуске.
# Для staging/production их значения задаются в ops/build-env/<окружение>.env (публичные данные,
# секретов там быть не может) и передаются в образ как build-args. Серверные переменные (без NEXT_PUBLIC_)
# читаются при запуске контейнера из /opt/aula/env/web.env.

# -----------------------------------------------------------------------------
# Сборка (публичные, попадают в браузер)
# -----------------------------------------------------------------------------
# Origin API для браузера, без /api/v1 (пути клиента @aula/api-client уже содержат /api/v1).
# Production: origin самой витрины (https://aula.kz) — Caddy проксирует /api/v1/* в API на том же домене:
# нет CORS-preflight (минус один запрос на 4G), cookie первого уровня. Локально — API напрямую.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Канонический адрес сайта: canonical, sitemap.xml, Open Graph, микроразметка Restaurant/Menu.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# development | staging | production (Sentry, отключение аналитики и индексации вне production).
NEXT_PUBLIC_ENVIRONMENT=development

# Аналитика (ТЗ: Google Analytics, Яндекс.Метрика, цели). Пусто — счётчик не подключается.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# Sentry (браузер + сервер Next.js). Пусто — выключено.
NEXT_PUBLIC_SENTRY_DSN=

# Карта (страницы филиалов, выбор адреса доставки): yandex | 2gis | osm
NEXT_PUBLIC_MAP_PROVIDER=osm
# Ключ JavaScript API Яндекс.Карт (ограничьте по HTTP Referer в кабинете разработчика).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Ключ 2ГИС MapGL (ограничьте по домену).
NEXT_PUBLIC_2GIS_API_KEY=
# Тайлы для Leaflet при NEXT_PUBLIC_MAP_PROVIDER=osm (для production — свой/коммерческий тайл-сервер).
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# -----------------------------------------------------------------------------
# Сервер (читаются при запуске, в браузер не попадают)
# -----------------------------------------------------------------------------
# Адрес API для серверного рендеринга (SSR, sitemap). В Docker — внутренняя сеть: http://api:3000
API_INTERNAL_URL=http://localhost:3000
# Порт сервера Next.js (в образе — 3001).
PORT=3001

# Загрузка source maps в Sentry при сборке (секрет CI, передаётся как BuildKit-секрет, не build-arg).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=aula-web
