# Админ-панель AULA (Vite). Переменные VITE_* встраиваются при сборке.

# Адрес API. Пусто — тот же origin (рекомендуется: reverse proxy отдаёт /api/* на API,
# refresh-cookie админки имеет SameSite=Strict и path=/api/v1/admin/auth).
VITE_API_URL=

# Только для `pnpm dev`/`preview`: куда проксировать /api.
VITE_DEV_API_PROXY=http://localhost:3000

# Sentry (без DSN — отключён).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Тайлы карты (выбор точки филиала, зоны доставки). По умолчанию — OpenStreetMap.
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
